{
  "openapi": "3.0.0",
  "info": {
    "title": "finance_management_app Apies",
    "version": "1.0.0",
    "description": ""
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/userRouter/signup": {
      "post": {
        "tags": [
          "userRouter"
        ],
        "summary": "Register a new user",
        "description": "Create a new user account with full name, email, and password",
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "409": {
            "description": "Conflict"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fullName",
                  "email",
                  "password"
                ],
                "properties": {
                  "fullName": {
                    "type": "string",
                    "example": "Alexander Wright"
                  },
                  "email": {
                    "type": "string",
                    "example": "alexander@domain.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "Password@123"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/userRouter/login": {
      "post": {
        "tags": [
          "userRouter"
        ],
        "summary": "User login",
        "description": "Authenticate user with email and password",
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "alexander@domain.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "Password@123"
                  },
                  "rememberMe": {
                    "type": "boolean",
                    "example": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/userRouter/checkislogin": {
      "get": {
        "tags": [
          "userRouter"
        ],
        "summary": "Check authentication status",
        "description": "Verify if current session or token is authenticated",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/userRouter/logout": {
      "post": {
        "tags": [
          "userRouter"
        ],
        "summary": "Logout user",
        "description": "Clear authentication cookie and invalidate session",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  }
}